---
const works = [
  { title: '云朵小猫', note: '给朋友家的橘猫画了一张会飞的肖像。', image: 'https://picsum.photos/seed/alisa-cloud-cat/1200/900', className: 'md:col-span-2 md:row-span-2' },
  { title: '夏日汽水', note: '把放学路上的晚风装进瓶子里。', image: 'https://picsum.photos/seed/alisa-soda/800/800', className: 'md:col-span-2' },
  { title: '兔子邮局', note: '一封寄给月亮的信。', image: 'https://picsum.photos/seed/alisa-rabbit/800/800', className: 'md:col-span-2' },
  { title: '花园派对', note: '花朵、朋友和一场粉色的雨。', image: 'https://picsum.photos/seed/alisa-garden/1200/700', className: 'md:col-span-4' }
];

const projects = [
  { title: '动物朋友肖像', copy: '为朋友们的宠物画专属的小故事。', image: 'https://picsum.photos/seed/alisa-pet-portrait/1000/700' },
  { title: '我的漫画角', copy: '每周更新一格，记录脑袋里发生的奇妙事。', image: 'https://picsum.photos/seed/alisa-comic/1000/700' },
  { title: '颜色日记', copy: '用一组颜色收藏每天最喜欢的瞬间。', image: 'https://picsum.photos/seed/alisa-color-diary/1000/700' }
];
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Alisa 的绘画与日常个人主页。" />
    <title>Alisa 的小宇宙</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cabin+Sketch:wght@400;700&family=Noto+Sans+SC:wght@400;500;700;900&display=swap" rel="stylesheet" />
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
      tailwind.config = { theme: { extend: { fontFamily: { display: ['Cabin Sketch', 'cursive'], body: ['Noto Sans SC', 'sans-serif'] } } } }
    </script>
  </head>
  <body class="bg-[#fffaf2] font-body text-[#27223a] antialiased transition-colors duration-500 dark:bg-[#1d1c2b] dark:text-[#fff6ec]">
    <main class="w-full max-w-full overflow-x-hidden">
      <nav class="fixed left-1/2 top-5 z-50 flex w-[calc(100%-2rem)] max-w-5xl -translate-x-1/2 items-center justify-between rounded-full border border-white/70 bg-[#fffaf2]/85 px-4 py-3 shadow-[0_12px_40px_rgba(61,37,71,0.12)] backdrop-blur-xl dark:border-white/10 dark:bg-[#29263b]/85 sm:px-6">
        <a href="#top" class="flex items-center gap-2 font-display text-2xl text-[#ef596f]" aria-label="返回首页">
          <span class="grid h-9 w-9 place-items-center rounded-full bg-[#ffcf69] text-lg text-[#27223a]">A</span>Alisa
        </a>
        <div class="hidden items-center gap-6 text-sm font-bold md:flex">
          <a class="hover:text-[#ef596f]" href="#about">关于我</a>
          <a class="hover:text-[#ef596f]" href="#works">作品</a>
          <a class="hover:text-[#ef596f]" href="#contact">联系我</a>
        </div>
        <button id="theme-toggle" class="grid h-10 w-10 place-items-center rounded-full bg-[#27223a] text-sm font-bold text-white transition-transform hover:scale-110 dark:bg-[#ffcf69] dark:text-[#27223a]" aria-label="切换明暗模式">夜</button>
      </nav>

      <section id="top" class="relative min-h-screen px-5 pb-16 pt-36 sm:px-8 lg:px-12">
        <div class="absolute inset-x-0 top-0 -z-10 h-[38rem] bg-[radial-gradient(circle_at_15%_28%,rgba(255,205,103,.7),transparent_25%),radial-gradient(circle_at_84%_14%,rgba(239,89,111,.34),transparent_25%),radial-gradient(circle_at_62%_70%,rgba(159,216,203,.5),transparent_28%)]"></div>
        <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-[1.1fr_.9fr] lg:gap-8">
          <div class="order-2 lg:order-1">
            <p class="mb-5 font-bold tracking-[0.18em] text-[#ef596f]">绘画 · 宠物 · 漫画 · 快乐日常</p>
            <h1 class="max-w-6xl font-display text-[clamp(3.6rem,8vw,8.2rem)] leading-[0.84] tracking-[-0.055em] text-[#27223a] dark:text-[#fff6ec]">把可爱的日常<br />画成会呼吸的颜色</h1>
            <p class="mt-8 max-w-xl text-lg leading-8 text-[#5c566a] dark:text-[#e6dfea]">嗨，我是 Alisa。12 岁，喜欢把人物、动物和脑袋里突然冒出来的故事画在纸上，也喜欢把每一天的小惊喜收藏起来。</p>
            <div class="mt-9 flex flex-wrap gap-3">
              <a href="#works" class="rounded-full bg-[#27223a] px-7 py-4 font-bold text-white transition duration-300 hover:-translate-y-1 hover:bg-[#ef596f] dark:bg-[#ffcf69] dark:text-[#27223a]">看看我的作品</a>
              <a href="#daily" class="rounded-full border-2 border-[#27223a] px-7 py-4 font-bold transition duration-300 hover:-translate-y-1 hover:bg-[#27223a] hover:text-white dark:border-[#fff6ec] dark:hover:bg-[#fff6ec] dark:hover:text-[#27223a]">我的日常</a>
            </div>
          </div>
          <div class="hero-art order-1 relative mx-auto aspect-square w-full max-w-md lg:order-2">
            <div class="absolute inset-0 rotate-6 rounded-[42%_58%_49%_51%/43%_42%_58%_57%] bg-[#ffcf69]"></div>
            <img class="relative h-full w-full -rotate-3 rounded-[55%_45%_40%_60%/45%_55%_45%_55%] object-cover mix-blend-multiply contrast-110 saturate-125 dark:mix-blend-normal" src="https://picsum.photos/seed/alisa-portrait/1000/1000" alt="Alisa 的手绘风肖像" />
            <div class="absolute -bottom-5 -left-6 rounded-[2rem] bg-[#ef596f] px-5 py-4 font-display text-3xl text-white shadow-xl">画画中</div>
            <div class="absolute -right-4 top-10 h-16 w-16 rounded-full border-[10px] border-[#9fd8cb]"></div>
          </div>
        </div>
      </section>

      <section id="about" class="px-5 py-32 sm:px-8 md:py-48 lg:px-12">
        <div class="mx-auto grid max-w-6xl gap-12 md:grid-cols-[.7fr_1.3fr] md:items-start">
          <h2 class="font-display text-6xl leading-none text-[#ef596f] sm:text-7xl">从幼儿园起，<br />我就在画画。</h2>
          <div>
            <p class="reveal-text text-2xl font-medium leading-relaxed text-[#40394c] dark:text-[#f1eaf4]">第一支蜡笔画的是一只圆圆的小猫。后来，我参加过业余绘画比赛，也常常为同学和朋友画他们家的宠物。现在，画画依然是我认识世界、分享快乐的方式。</p>
            <div class="mt-10 grid grid-cols-2 gap-3 text-sm font-bold sm:grid-cols-4">
              <span class="rounded-2xl bg-[#ffe6eb] p-4 text-[#be3650]">人物</span><span class="rounded-2xl bg-[#e1f2ed] p-4 text-[#317368]">动物</span><span class="rounded-2xl bg-[#fff0cf] p-4 text-[#8b5c08]">漫画</span><span class="rounded-2xl bg-[#e9e4ff] p-4 text-[#56458d]">想象力</span>
            </div>
          </div>
        </div>
      </section>

      <section id="works" class="bg-[#27223a] px-5 py-32 text-[#fffaf2] sm:px-8 md:py-48 lg:px-12">
        <div class="mx-auto max-w-7xl">
          <div class="mb-14 flex flex-col justify-between gap-6 md:flex-row md:items-end">
            <h2 class="font-display text-6xl leading-none sm:text-8xl">最近画了什么？</h2>
            <p class="max-w-sm text-lg leading-7 text-[#d5cede]">每一张画都是一个刚刚好被发现的小世界。</p>
          </div>
          <div class="grid grid-flow-dense auto-rows-[13rem] gap-4 md:grid-cols-4">
            {works.map((work) => (
              <article class:list={['work-card group relative overflow-hidden rounded-[2rem] bg-[#423d53]', work.className]}>
                <img src={work.image} alt={work.title} class="h-full w-full object-cover opacity-85 transition duration-700 ease-out group-hover:scale-105 group-hover:opacity-100" loading="lazy" />
                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#191622]/90 to-transparent p-6 pt-20">
                  <h3 class="font-display text-3xl">{work.title}</h3><p class="mt-1 text-sm text-[#f3edf5]">{work.note}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="daily" class="gallery-section px-5 py-32 sm:px-8 md:py-48 lg:px-12">
        <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[.8fr_1.2fr]">
          <div class="gallery-title lg:sticky lg:top-36 lg:h-fit"><h2 class="font-display text-6xl leading-none text-[#ef596f] sm:text-8xl">日常像<br />一盒彩笔。</h2><p class="mt-7 max-w-sm text-lg leading-8 text-[#5c566a] dark:text-[#e6dfea]">有时候是晚饭后的散步，有时候是一张没有计划的涂鸦。</p></div>
          <div class="space-y-6">
            {projects.map((project) => (
              <article class="daily-card group grid overflow-hidden rounded-[2rem] bg-[#f4e7dc] md:grid-cols-[.85fr_1.15fr] dark:bg-[#302d40]">
                <div class="overflow-hidden"><img src={project.image} alt={project.title} class="h-full min-h-56 w-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" /></div>
                <div class="flex flex-col justify-between p-7 sm:p-9"><div><h3 class="font-display text-4xl text-[#27223a] dark:text-[#fff6ec]">{project.title}</h3><p class="mt-4 leading-7 text-[#5c566a] dark:text-[#e6dfea]">{project.copy}</p></div><a href="#contact" class="mt-8 inline-block font-bold text-[#ef596f]">想看更多作品</a></div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="contact" class="px-5 pb-8 pt-20 sm:px-8 lg:px-12">
        <div class="mx-auto max-w-7xl rounded-[3rem] bg-[#ef596f] px-6 py-20 text-white sm:px-12 md:py-28 lg:px-20">
          <div class="grid gap-12 lg:grid-cols-2">
            <div><p class="font-bold tracking-[0.18em]">来和我打个招呼</p><h2 class="mt-5 font-display text-6xl leading-none sm:text-8xl">一起画点<br />有趣的吧。</h2><a class="mt-8 inline-block text-xl font-bold underline decoration-2 underline-offset-8" href="mailto:hello@alisa.art">hello@alisa.art</a></div>
            <form class="grid gap-4" action="mailto:hello@alisa.art" method="post" enctype="text/plain"><label class="sr-only" for="name">你的名字</label><input id="name" name="name" required placeholder="你的名字" class="rounded-2xl bg-white/15 px-5 py-4 placeholder:text-white/75 outline-none ring-white/0 transition focus:ring-2" /><label class="sr-only" for="message">想说的话</label><textarea id="message" name="message" required rows="5" placeholder="想对我说的话" class="rounded-2xl bg-white/15 px-5 py-4 placeholder:text-white/75 outline-none ring-white/0 transition focus:ring-2"></textarea><button class="rounded-full bg-[#27223a] px-7 py-4 font-bold text-white transition hover:-translate-y-1 hover:bg-[#fffaf2] hover:text-[#27223a]" type="submit">发送留言</button></form>
          </div>
        </div>
        <footer class="mx-auto flex max-w-7xl flex-col gap-3 px-2 py-10 text-sm font-medium text-[#6e6878] sm:flex-row sm:justify-between dark:text-[#c9c1d0]"><span>Alisa 的小宇宙</span><span>用好奇心和颜色慢慢长大。</span></footer>
      </section>
    </main>

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      gsap.registerPlugin(ScrollTrigger);
      const toggle = document.querySelector('#theme-toggle');
      toggle?.addEventListener('click', () => { document.documentElement.classList.toggle('dark'); toggle.textContent = document.documentElement.classList.contains('dark') ? '日' : '夜'; });
      gsap.utils.toArray<HTMLElement>('.work-card, .daily-card').forEach((card) => gsap.fromTo(card, { scale: 0.88, opacity: 0.25 }, { scale: 1, opacity: 1, duration: 1, ease: 'power3.out', scrollTrigger: { trigger: card, start: 'top 88%', end: 'bottom 25%', scrub: 0.6 } }));
      gsap.fromTo('.reveal-text', { opacity: 0.12 }, { opacity: 1, scrollTrigger: { trigger: '.reveal-text', start: 'top 85%', end: 'bottom 50%', scrub: 0.8 } });
    </script>
  </body>
</html>
